# blackstork-cli reads variables from the process environment and an optional
# local .env file. Copy this file to .env and set only the values your templates
# and plugins require. Never commit .env.

# Optional CLI telemetry. Telemetry is disabled unless explicitly enabled.
BLACKSTORK_OTELP_ENABLED=false
BLACKSTORK_OTELP_URL=https://otelp.blackstork.io

# Example template and plugin credentials. Keep these commented until needed.
# BLACKSTORK_API_TOKEN=
# BLACKSTORK_OPENAI_API_KEY=
# BLACKSTORK_OPENCTI_TOKEN=
# BLACKSTORK_ECLECTICIQ_API_TOKEN=

# Templates expose BLACKSTORK_* variables by default. A template can reference
# a permitted variable as env.BLACKSTORK_EXAMPLE_VALUE.
# BLACKSTORK_EXAMPLE_VALUE=
