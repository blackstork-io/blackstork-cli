---
title: "`{{ .name }}` publisher"
plugin:
  name: {{ .plugin.Name }}
  description: {{ .publisher.Doc | quote }}
  tags: {{ formatTags .publisher.Tags }}
  version: "{{ .plugin.Version }}"
  {{- if eq .plugin_shortname "nist_nvd" }}
  source_github: "https://github.com/blackstork-io/blackstork-cli/tree/main/internal/nistnvd/"
  {{- else }}
  source_github: "https://github.com/blackstork-io/blackstork-cli/tree/main/internal/{{ .plugin_shortname }}/"
  {{- end }}
resource:
  type: publisher
type: docs
---

