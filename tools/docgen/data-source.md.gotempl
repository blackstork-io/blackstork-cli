  source_github: "https://github.com/blackstork-io/blackstork-cli/tree/main/plugins/nistnvd/"
  {{- else }}
  source_github: "https://github.com/blackstork-io/blackstork-cli/tree/main/plugins/{{ .plugin_shortname }}/"
  {{- end }}
resource:
  type: data-source
type: docs
---

